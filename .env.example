# =============================================================================
# Wazuh ModSecurity SIEM Lab - Environment Variables Template
# Copy this file to .env and adjust variables to match your environment.
# =============================================================================

# --- Network Scheme & Host Mapping ---
# Deployment Environment: "local" (VMs / Hyper-V / VMware) or "cloud" (AWS / DigitalOcean / VPS)
DEPLOY_ENV=local

# VM 1: Attacker Machine IP (Kali Linux)
ATTACKER_IP=192.168.1.10

# VM 2: Web Server & WAF Host IP
TARGET_IP=192.168.1.20
TARGET_PORT=80
TARGET_SCHEME=http

# VM 3: Wazuh Manager / All-In-One Server IP
WAZUH_MANAGER_IP=192.168.1.30
WAZUH_AGENT_NAME=vm2-web-target
WAZUH_AGENT_GROUP=web-servers

# --- SIEM Performance & Resource Tuning ---
# Wazuh Indexer (OpenSearch) JVM Heap Size (Minimum 2g, Recommended 4g for production/cloud)
INDEXER_JAVA_HEAP=4g

# --- Alerts & Notification Integration ---
# Telegram Bot Webhook Integration for High-Severity Incident Alerts (Level >= 12 / Active Response)
TELEGRAM_ALERT_ENABLED=false
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Docker & Storage Paths ---
MODSEC_LOG_DIR=/var/log/modsec
DVWA_SECURITY_LEVEL=low

